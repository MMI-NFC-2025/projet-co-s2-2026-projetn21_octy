---
// @ts-nocheck
import Layout from "../layouts/Layout.astro";
import {
  getEtapesByParcours,
  getParcours,
  getQuizByEtape,
} from "../js/backend.mjs";

const parcours = await getParcours();
const initialProfileTab =
  Astro.url.searchParams.get("tab") === "progression"
    ? "progression"
    : "profil";

const progressionParcours = await Promise.all(
  parcours.map(async (item, index) => {
    const order = Number(item.ordre) || index + 1;
    const etapes = await getEtapesByParcours(item.id);
    const quizIds = await Promise.all(
      etapes.map(async (etape) => {
        const quiz = await getQuizByEtape(etape.id);
        return quiz[0]?.id ?? "";
      }),
    );

    return {
      id: item.id,
      order,
      title: item.nom_parcours || "Description",
      isPremium: item.statut === "payant",
      fallbackProgress: 0,
      quizIds: quizIds.filter(Boolean),
    };
  }),
);

const orderedProgressionParcours = progressionParcours.sort(
  (a, b) => a.order - b.order,
);
const freeProgressionParcours = orderedProgressionParcours.filter(
  (item) => !item.isPremium,
);
const premiumProgressionParcours = orderedProgressionParcours.filter(
  (item) => item.isPremium,
);
const freeLevelMax = freeProgressionParcours.reduce(
  (total, item) => total + item.quizIds.length,
  0,
);
const progressionPayload = JSON.stringify(
  orderedProgressionParcours.map((item) => ({
    id: item.id,
    quizIds: item.quizIds,
  })),
).replace(/</g, "\\u003c");

const freeAvatars = [
  { src: "/svg/octy-neutral.svg", label: "Octy neutre", requiredLevel: 1 },
  { src: "/svg/octy-content.svg", label: "Octy content", requiredLevel: 4 },
  { src: "/svg/octystudieux.svg", label: "Octy intello", requiredLevel: 7 },
  { src: "/svg/octy-shocked.svg", label: "Octy choque", requiredLevel: 10 },
  { src: "/svg/octy-angry.svg", label: "Octy enerve", requiredLevel: 13 },
  { src: "/svg/octy-sad.svg", label: "Octy triste", requiredLevel: 16 },
];

const premiumAvatars = [
  {
    src: "/svg/octy-premium-blue-neutral.svg",
    label: "Octy neutre premium bleu",
  },
  {
    src: "/svg/octy-premium-blue-content.svg",
    label: "Octy content premium bleu",
  },
  {
    src: "/svg/octy-premium-blue-studious.svg",
    label: "Octy intello premium bleu",
  },
  {
    src: "/svg/octy-premium-blue-shocked.svg",
    label: "Octy choque premium bleu",
  },
  { src: "/svg/octy-premium-blue-sad.svg", label: "Octy triste premium bleu" },
  {
    src: "/svg/octy-premium-blue-angry.svg",
    label: "Octy enerve premium bleu",
  },
  {
    src: "/svg/octy-premium-purple-neutral.svg",
    label: "Octy neutre premium violet",
  },
  {
    src: "/svg/octy-premium-purple-content.svg",
    label: "Octy content premium violet",
  },
  {
    src: "/svg/octy-premium-purple-studious.svg",
    label: "Octy intello premium violet",
  },
  {
    src: "/svg/octy-premium-purple-shocked.svg",
    label: "Octy choque premium violet",
  },
  {
    src: "/svg/octy-premium-purple-sad.svg",
    label: "Octy triste premium violet",
  },
  {
    src: "/svg/octy-premium-purple-angry.svg",
    label: "Octy enerve premium violet",
  },
];
---

<Layout titre="Profil - Octy">
  <main
    class={`profile-page ${initialProfileTab === "progression" ? "is-progression-active" : ""}`}
    data-profile-page
    data-free-level-max={freeLevelMax}
    data-max-user-level="16"
  >
    <nav class="profile-tabs" aria-label="Profil">
      <button
        class={`profile-tab ${initialProfileTab === "profil" ? "is-active" : ""}`}
        type="button"
        data-tab-button="profil">Profil</button
      >
      <button
        class={`profile-tab ${initialProfileTab === "progression" ? "is-active" : ""}`}
        type="button"
        data-tab-button="progression">Progression</button
      >
    </nav>

    <section
      class={`profile-panel ${initialProfileTab === "profil" ? "is-active" : ""}`}
      data-tab-panel="profil"
      aria-labelledby="profile-title"
    >
      <section
        class="profile-page-hero progression-overview-hero"
        data-profile-page-hero
      >
        <img
          src="/svg/vagues.svg"
          alt=""
          aria-hidden="true"
          class="progression-overview-waves"
        />

        <div class="progression-avatar-feature">
          <div class="progression-avatar-disc" aria-hidden="true">
            <img src="/svg/octy-neutral.svg" alt="" data-current-avatar />
          </div>
        </div>

        <p>MON PROFIL</p>
        <h1><span data-profile-user-name>UTILISATEUR</span>&nbsp;!</h1>
      </section>

      <section class="profile-info">
        <h2 id="profile-title">Modifie tes<br />informations&nbsp;!</h2>

        <form class="profile-form" data-profile-form>
          <label>
            <span>Adresse email</span>
            <input
              name="email"
              type="email"
              placeholder="Entre ta nouvelle adresse mail..."
              autocomplete="email"
              aria-describedby="profileMessage"
            />
          </label>

          <label>
            <span>Le nom que tu veux utiliser</span>
            <input
              name="name"
              type="text"
              placeholder="Entre ton nouveau nom..."
              autocomplete="name"
              aria-describedby="profileMessage"
            />
          </label>

          <label>
            <span>Mot de passe</span>
            <input
              name="password"
              type="password"
              placeholder="Entre ton nouveau mot de passe..."
              autocomplete="new-password"
              minlength="6"
              aria-describedby="profileMessage"
            />
          </label>

          <button type="submit">Valider</button>
        </form>

        <p id="profileMessage" class="profile-message" data-profile-message aria-live="polite"></p>
      </section>

      <section class="profile-icons" aria-labelledby="icon-title">
        <h2 id="icon-title">Modifie ton<br />icone Octy&nbsp;!</h2>

        <div class="avatar-grid">
          {
            freeAvatars.map((avatar) => (
              <button
                type="button"
                class={`avatar-option ${avatar.requiredLevel > 1 ? "is-level-locked is-locked" : ""}`}
                data-avatar={avatar.src}
                data-required-level={avatar.requiredLevel}
                aria-label={
                  avatar.requiredLevel > 1
                    ? `${avatar.label} - Debloquee au niveau ${avatar.requiredLevel}`
                    : avatar.label
                }
                disabled={avatar.requiredLevel > 1}
              >
                <img src={avatar.src} alt="" />
                {avatar.requiredLevel > 1 && (
                  <>
                    <span
                      class="lock-badge avatar-lock-badge"
                      aria-hidden="true"
                      data-avatar-lock-badge
                    >
                      <img src="/svg/lock.svg" alt="" />
                    </span>
                    <span class="avatar-unlock-label" data-avatar-unlock-label>
                      Niveau {avatar.requiredLevel}
                    </span>
                  </>
                )}
              </button>
            ))
          }
        </div>
      </section>

      <section
        class="profile-premium-icons"
        aria-labelledby="premium-icon-title"
      >
        <h2 id="premium-icon-title">
          Plus d&rsquo;icones avec<br />Premium&nbsp;!
        </h2>

        <div class="avatar-grid premium-grid">
          {
            premiumAvatars.map((avatar) => (
              <button
                type="button"
                class="avatar-option is-locked"
                aria-label={avatar.label}
                disabled
              >
                <img src={avatar.src} alt="" />
                <span class="lock-badge" aria-hidden="true">
                  <img src="/svg/lock.svg" alt="" />
                </span>
              </button>
            ))
          }
        </div>

        <button class="logout-button" type="button" data-logout
          >Se d&eacute;connecter</button
        >
      </section>
    </section>

    <section
      class={`profile-panel progression-panel ${initialProfileTab === "progression" ? "is-active" : ""}`}
      data-tab-panel="progression"
      aria-labelledby="progression-title"
    >
      <section class="progression-overview-hero">
        <img
          src="/svg/vagues.svg"
          alt=""
          aria-hidden="true"
          class="progression-overview-waves"
        />

        <div class="progression-avatar-feature">
          <div class="progression-avatar-disc" aria-hidden="true">
            <img src="/svg/octy-neutral.svg" alt="" data-progress-avatar />
          </div>
        </div>

        <p>TOUT SUR TA PROGRESSION</p>
        <h1 id="progression-title">
          <span data-progress-user-name>UTILISATEUR</span>&nbsp;!
        </h1>
      </section>

      <section
        class="progression-free-section"
        aria-label="Progression gratuite"
      >
        <h2 class="progression-section-label">TA PROGRESSION&nbsp;:</h2>
        <p class="progression-level">
          TU ES NIVEAU <span data-progression-level>0</span>&nbsp;!
        </p>

        <div class="progression-card-stack">
          {
            freeProgressionParcours.map((item) => (
              <a
                href={`/parcours/${item.id}/progression`}
                class={`progression-path-card ${item.fallbackProgress === 0 ? "is-empty" : ""}`}
                data-progress-card
                data-parcours-id={item.id}
                data-default-progress={item.fallbackProgress}
                style={`--path-progress: ${item.fallbackProgress}%`}
              >
                <h2>Parcours {item.order}</h2>
                <p>{item.title}</p>
                <div
                  class="path-progress"
                  aria-label={`Progression parcours ${item.order}`}
                >
                  <div class="path-progress-track">
                    <span class="path-progress-fill" />
                    <strong data-path-progress-label>
                      {item.fallbackProgress}%
                    </strong>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>

      <div class="progression-premium-wave" aria-hidden="true">
        <img src="/svg/fond_bas_page.svg" alt="" />
      </div>

      <section
        class="progression-premium-section"
        aria-label="Progression premium"
      >
        <h2 class="progression-premium-title">PARCOURS PREMIUM&nbsp;:</h2>

        <div class="progression-card-stack premium-stack">
          {
            premiumProgressionParcours.map((item) => (
              <a
                href={`/parcours/${item.id}/progression`}
                class={`progression-path-card is-premium ${item.fallbackProgress === 0 ? "is-empty" : ""}`}
                data-progress-card
                data-parcours-id={item.id}
                data-default-progress={item.fallbackProgress}
                style={`--path-progress: ${item.fallbackProgress}%`}
              >
                <h2>Parcours {item.order}</h2>
                <p>Description</p>
                <div
                  class="path-progress"
                  aria-label={`Progression parcours ${item.order}`}
                >
                  <div class="path-progress-track">
                    <span class="path-progress-fill" />
                    <strong data-path-progress-label>
                      {item.fallbackProgress}%
                    </strong>
                  </div>
                </div>
              </a>
            ))
          }
        </div>
      </section>
    </section>

    <script
      type="application/json"
      id="profile-progression-data"
      set:html={progressionPayload}
    />
  </main>
</Layout>

<style>
  .profile-page {
    min-height: 100vh;
    background: #e84a4c;
    color: #ffcfa5;
    font-family: "Source Sans 3", Inter, sans-serif;
  }

  .profile-page-hero {
    display: block;
  }

  .profile-page.is-progression-active .profile-page-hero {
    display: none;
  }

  .profile-tabs {
    display: grid;
    height: 44px;
    grid-template-columns: 1fr 1fr;
    background: #ee947b;
  }

  .profile-tab {
    border: 0;
    background: #ee947b;
    color: rgba(228, 77, 76, 0.52);
    cursor: pointer;
    font-family: "Source Sans 3", Inter, sans-serif;
    font-size: 16px;
    font-weight: 900;
    line-height: 44px;
    text-transform: uppercase;
  }

  .profile-tab.is-active {
    border-radius: 0 999px 999px 0;
    background: #ffcfa5;
    color: #e44d4c;
  }

  .profile-tab:nth-child(2).is-active {
    border-radius: 999px 0 0 999px;
  }

  .profile-panel {
    display: none;
  }

  .profile-panel.is-active {
    display: block;
  }

  .profile-info {
    position: relative;
    background: #ffcfa5;
    color: #e44d4c;
    padding: 48px 27px 65px;
  }

  .profile-info h2,
  .profile-icons h2,
  .profile-premium-icons h2,
  .progression-overview-hero h1,
  .progression-overview-hero p,
  .progression-section-label,
  .progression-level,
  .progression-premium-title,
  .progression-path-card h2,
  .progression-path-card p {
    margin: 0;
  }

  .profile-info h2 {
    color: #e44d4c;
    font-size: 28px;
    font-weight: 900;
    line-height: 28px;
    text-align: center;
    text-transform: uppercase;
  }

  .profile-form {
    display: flex;
    width: min(321px, 100%);
    flex-direction: column;
    gap: 13px;
    margin: 18px auto 0;
  }

  .profile-form label {
    display: flex;
    flex-direction: column;
    gap: 5px;
    color: #1f1a17;
    font-family: Inter, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 600;
    line-height: 15px;
  }

  .profile-form input {
    height: 37px;
    border: 1.5px solid rgba(228, 77, 76, 0.7);
    border-radius: 10px;
    background: transparent;
    color: #e44d4c;
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    outline: none;
    padding: 0 16px;
  }

  .profile-form input::placeholder {
    color: rgba(235, 104, 86, 0.68);
  }

  .profile-form input:focus {
    border-color: #e44d4c;
  }

  .profile-form button {
    width: 128px;
    height: 43px;
    align-self: flex-end;
    border: 0;
    border-radius: 999px;
    background: #e44d4c;
    color: #ffcfa5;
    cursor: pointer;
    font-size: 18px;
    font-weight: 800;
    margin-top: 20px;
  }

  .profile-message {
    min-height: 18px;
    margin: 10px 0 0;
    color: #e44d4c;
    font-family: Inter, system-ui, sans-serif;
    font-size: 12px;
    text-align: center;
  }

  .profile-icons,
  .profile-premium-icons {
    background: #e84a4c;
    padding: 59px 0 0;
    text-align: center;
  }

  .profile-icons {
    position: relative;
  }

  .profile-icons::before {
    position: absolute;
    right: 0;
    bottom: 100%;
    left: 0;
    height: 35px;
    background: #e84a4c;
    content: "";
    mask: url("/svg/hero.svg") center bottom / 468px 174px no-repeat;
    pointer-events: none;
    transform: scaleY(-1);
    transform-origin: center;
    -webkit-mask: url("/svg/hero.svg") center bottom / 468px 174px no-repeat;
  }

  .profile-icons h2,
  .profile-premium-icons h2 {
    color: #ffcfa5;
    font-size: 27px;
    font-weight: 900;
    line-height: 28px;
    text-transform: uppercase;
  }

  .avatar-grid {
    display: grid;
    width: 221px;
    grid-template-columns: repeat(2, 96px);
    gap: 20px 29px;
    margin: 25px auto 0;
  }

  .avatar-option {
    position: relative;
    display: flex;
    width: 96px;
    height: 96px;
    align-items: center;
    justify-content: center;
    border: 4px solid #ffcfa5;
    border-radius: 9px;
    background: #ef6c55;
    cursor: pointer;
    padding: 0;
  }

  .avatar-option:disabled {
    cursor: not-allowed;
  }

  .avatar-option img {
    display: block;
    width: 78px;
    height: auto;
  }

  .avatar-option.is-selected {
    border-color: #8c1b19;
    box-shadow: 0 0 0 4px rgba(255, 207, 165, 0.7);
  }

  .profile-icons .avatar-option:last-child:nth-child(odd) {
    grid-column: 1 / -1;
    justify-self: center;
  }

  .avatar-option.is-locked.is-level-locked {
    border-color: rgba(255, 207, 165, 0.7);
    background: #d95a4d;
  }

  .avatar-option.is-locked.is-level-locked > img {
    opacity: 0.32;
    filter: saturate(0.7);
  }

  .avatar-option.is-locked.is-level-locked::after {
    position: absolute;
    inset: 0;
    border-radius: 5px;
    background: rgba(132, 31, 29, 0.32);
    content: "";
    pointer-events: none;
  }

  .profile-premium-icons {
    padding-top: 46px;
    padding-bottom: 32px;
  }

  .profile-premium-icons h2 {
    font-size: 22px;
    line-height: 25px;
  }

  .premium-grid {
    gap: 18px 29px;
    margin-top: 27px;
  }

  .avatar-option.is-locked {
    border-color: #b7b7b7;
    background: #898989;
    cursor: not-allowed;
  }

  .avatar-option.is-locked > img {
    opacity: 0.96;
  }

  .lock-badge {
    position: absolute;
    top: -10px;
    right: -10px;
    display: flex;
    width: 27px;
    height: 27px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #d7d7d7;
  }

  .lock-badge img {
    width: 14px;
    height: 19px;
  }

  .avatar-lock-badge,
  .avatar-unlock-label {
    z-index: 2;
  }

  .avatar-unlock-label {
    position: absolute;
    right: 6px;
    bottom: 6px;
    left: 6px;
    display: block;
    border-radius: 999px;
    background: #ffcfa5;
    color: #e44d4c;
    font-size: 10px;
    font-weight: 900;
    line-height: 18px;
    text-transform: uppercase;
  }

  .logout-button {
    display: block;
    width: min(321px, calc(100vw - 54px));
    height: 51px;
    margin: 34px auto 0;
    border: 0;
    border-radius: 999px;
    background: #ffcfa5;
    color: #e44d4c;
    cursor: pointer;
    font-family: "Source Sans 3", Inter, sans-serif;
    font-size: 16px;
    font-weight: 800;
  }

  .progression-panel {
    min-height: calc(100vh - 172px);
    background: #e44d4c;
  }

  .progression-overview-hero {
    position: relative;
    height: 368px;
    overflow: hidden;
    background: #eb6856;
    text-align: center;
  }

  .progression-overview-waves {
    position: absolute;
    top: 0;
    left: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: auto;
    pointer-events: none;
  }

  .progression-avatar-feature {
    position: relative;
    z-index: 1;
    width: 180px;
    height: 180px;
    margin: 58px auto 0;
  }

  .progression-avatar-disc {
    display: flex;
    width: 180px;
    height: 180px;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: #ffcfa5;
  }

  .progression-avatar-disc img {
    display: block;
    width: 122px;
    height: auto;
  }

  .progression-overview-hero p {
    position: relative;
    z-index: 1;
    margin-top: 20px;
    color: #ffcfa5;
    font-size: 18px;
    font-weight: 900;
    line-height: 22px;
    text-transform: uppercase;
  }

  .progression-overview-hero h1 {
    position: relative;
    z-index: 1;
    color: #ffcfa5;
    font-size: 31px;
    font-weight: 900;
    line-height: 33px;
    text-transform: uppercase;
  }

  .progression-free-section {
    position: relative;
    padding: 22px 0 80px;
    background: #ffcfa5;
    color: #e44d4c;
  }

  .progression-section-label,
  .progression-level,
  .progression-card-stack {
    position: relative;
    z-index: 1;
  }

  .progression-section-label,
  .progression-premium-title {
    width: min(315px, calc(100vw - 78px));
    margin-inline: auto;
    color: #e44d4c;
    font-size: 18px;
    font-weight: 900;
    line-height: 22px;
    text-transform: uppercase;
  }

  .progression-level {
    margin: 36px auto 30px;
    color: #e44d4c;
    font-size: 31px;
    font-weight: 900;
    line-height: 34px;
    text-align: center;
    text-transform: uppercase;
  }

  .progression-card-stack {
    display: flex;
    width: min(315px, calc(100vw - 78px));
    flex-direction: column;
    gap: 26px;
    margin: 0 auto;
  }

  .progression-path-card {
    display: block;
    min-height: 194px;
    box-sizing: border-box;
    border-radius: 32px;
    background: #e84a4c;
    color: #ffcfa5;
    padding: 28px 21px 26px;
    text-decoration: none;
  }

  .progression-path-card h2 {
    color: #ffcfa5;
    font-size: 25px;
    font-weight: 900;
    line-height: 27px;
    text-transform: uppercase;
  }

  .progression-path-card p {
    min-height: 38px;
    margin-top: 5px;
    color: #ffcfa5;
    font-size: 17px;
    font-weight: 800;
    line-height: 18px;
  }

  .path-progress {
    display: flex;
    height: 54px;
    align-items: center;
    margin-top: 18px;
    border-radius: 27px;
    background: #ffcfa5;
    padding: 0 12px;
  }

  .path-progress-track {
    position: relative;
    flex: 1;
    height: 30px;
    border: 2px solid #e44d4c;
    border-radius: 16px;
    background: #ffcfa5;
    overflow: hidden;
  }

  .path-progress-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--path-progress, 0%);
    background: #e84a4c;
    transition: width 240ms ease;
  }

  .path-progress strong {
    position: relative;
    z-index: 1;
    display: flex;
    height: 100%;
    align-items: center;
    padding-left: 12px;
    color: #ffcfa5;
    font-size: 18px;
    font-weight: 900;
    line-height: 1;
  }

  .progression-path-card.is-empty .path-progress strong {
    color: #e44d4c;
  }

  .progression-premium-wave {
    position: relative;
    height: 35px;
    overflow: hidden;
    background: #e44d4c;
  }

  .progression-premium-wave img {
    display: none;
  }

  .progression-premium-wave::before {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 35px;
    background: #ffcfa5;
    content: "";
    mask: url("/svg/hero.svg") center bottom / 468px 174px no-repeat;
    -webkit-mask: url("/svg/hero.svg") center bottom / 468px 174px no-repeat;
  }

  .progression-premium-section {
    background: #e44d4c;
    padding: 24px 0 66px;
  }

  .progression-premium-title {
    color: #ffcfa5;
  }

  .premium-stack {
    gap: 30px;
    margin-top: 29px;
  }

  .progression-path-card.is-premium {
    min-height: 192px;
    background: #ffcfa5;
    color: #e44d4c;
    padding-top: 27px;
  }

  .progression-path-card.is-premium h2,
  .progression-path-card.is-premium p {
    color: #e44d4c;
  }

  .progression-path-card.is-premium .path-progress {
    margin-top: 34px;
    background: #ee947b;
  }

  .progression-path-card.is-premium .path-progress-track {
    background: #ee947b;
  }

  @media (max-width: 360px) {
    .profile-info {
      padding-inline: 22px;
    }

    .avatar-grid {
      width: 210px;
      grid-template-columns: repeat(2, 91px);
      gap: 18px 28px;
    }

    .avatar-option {
      width: 91px;
      height: 91px;
    }

    .progression-card-stack,
    .progression-section-label,
    .progression-premium-title {
      width: min(315px, calc(100vw - 54px));
    }
  }
</style>

<script>
  // @ts-nocheck
  import { pb, getProgressionsByUser } from "../js/backend.mjs";
  import {
    getCurrentUserId,
    getPocketBaseUser,
    getProgressPercent,
    getUserProgress,
    parseJson,
  } from "../js/progression.mjs";

  const root = document.querySelector("[data-profile-page]");

  const setMessage = (message, color = "#e44d4c") => {
    const target = root?.querySelector("[data-profile-message]");
    if (!target) return;
    target.textContent = message;
    target.style.color = color;
  };

  if (root instanceof HTMLElement) {
    const tabButtons = Array.from(root.querySelectorAll("[data-tab-button]"));
    const tabPanels = Array.from(root.querySelectorAll("[data-tab-panel]"));
    const form = root.querySelector("[data-profile-form]");
    const logoutButton = root.querySelector("[data-logout]");
    const avatarButtons = Array.from(root.querySelectorAll("[data-avatar]"));
    const currentAvatar = root.querySelector("[data-current-avatar]");
    const progressAvatar = root.querySelector("[data-progress-avatar]");
    const profileUserName = root.querySelector("[data-profile-user-name]");
    const progressUserName = root.querySelector("[data-progress-user-name]");
    const progressionLevel = root.querySelector("[data-progression-level]");
    const progressionDataElement = document.getElementById(
      "profile-progression-data",
    );
    const progressionData =
      parseJson(progressionDataElement?.textContent) || [];
    const progressionById = new Map(
      progressionData.map((item) => [item.id, item]),
    );
    const userId = getCurrentUserId("");
    const maxUserLevel = Number.parseInt(root.dataset.maxUserLevel || "16", 10);
    const userProgress = getUserProgress(userId || "guest");
    const avatarUnlockLevel = Math.min(
      Math.max(userProgress.level, 1),
      Number.isFinite(maxUserLevel) ? maxUserLevel : 16,
    );

    const getRelationId = (value) => {
      if (!value) return "";
      if (typeof value === "string") return value;
      if (typeof value === "object" && "id" in value) return value.id;
      return "";
    };

    const getSafePercent = (value) => {
      const percent = Number.parseInt(value, 10);
      if (!Number.isFinite(percent)) return 0;
      return Math.min(100, Math.max(0, percent));
    };

    const applyProgressCards = (pocketBaseProgressions = []) => {
      const pocketBaseByParcours = new Map(
        pocketBaseProgressions
          .map((item) => [getRelationId(item.parcours), item])
          .filter(([parcoursId]) => Boolean(parcoursId)),
      );

      root.querySelectorAll("[data-progress-card]").forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const pocketBaseProgression = pocketBaseByParcours.get(card.dataset.parcoursId);
        const parcoursProgression = progressionById.get(card.dataset.parcoursId);
        const quizIds = Array.isArray(parcoursProgression?.quizIds)
          ? parcoursProgression.quizIds
          : [];
        const progress = pocketBaseProgression
          ? getSafePercent(pocketBaseProgression.pourcentage)
          : getProgressPercent(quizIds, userProgress.completedQuizzes);
        const label = card.querySelector("[data-path-progress-label]");

        card.style.setProperty("--path-progress", `${progress}%`);
        card.classList.toggle("is-empty", progress === 0);

        if (label) {
          label.textContent = `${progress}%`;
        }
      });
    };

    const activateTab = (tab) => {
      tabButtons.forEach((button) => {
        button.classList.toggle("is-active", button.dataset.tabButton === tab);
      });

      tabPanels.forEach((panel) => {
        panel.classList.toggle("is-active", panel.dataset.tabPanel === tab);
      });

      root.classList.toggle("is-progression-active", tab === "progression");
    };

    tabButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const tab = button.dataset.tabButton || "profil";
        activateTab(tab);
        window.history.replaceState(
          null,
          "",
          tab === "progression" ? "/profil?tab=progression" : "/profil",
        );
      });
    });

    const initialTab =
      new URLSearchParams(window.location.search).get("tab") === "progression"
        ? "progression"
        : "profil";
    activateTab(initialTab);

    const pocketBaseUser = getPocketBaseUser();
    const storedName =
      localStorage.getItem("octyUserName") ||
      pocketBaseUser?.prenom_nom ||
      pocketBaseUser?.name ||
      "";

    const displayName = storedName ? storedName.toUpperCase() : "UTILISATEUR";

    if (profileUserName) {
      profileUserName.textContent = displayName;
    }

    if (progressUserName) {
      progressUserName.textContent = displayName;
    }

    if (form instanceof HTMLFormElement) {
      const emailInput = form.elements.namedItem("email");
      const nameInput = form.elements.namedItem("name");

      if (emailInput instanceof HTMLInputElement) {
        emailInput.value = pocketBaseUser?.email || "";
      }

      if (nameInput instanceof HTMLInputElement) {
        nameInput.value = storedName;
      }

      form.addEventListener("submit", async (event) => {
        event.preventDefault();

        const email = form.elements.namedItem("email");
        const name = form.elements.namedItem("name");
        const password = form.elements.namedItem("password");

        if (
          !(email instanceof HTMLInputElement) ||
          !(name instanceof HTMLInputElement) ||
          !(password instanceof HTMLInputElement)
        ) {
          return;
        }

        if (!userId) {
          setMessage("Connecte-toi pour modifier ton profil.");
          return;
        }

        const data = {};
        const nextEmail = email.value.trim();
        const nextName = name.value.trim();
        const nextPassword = password.value;

        if (nextEmail) data.email = nextEmail;
        data.prenom_nom = nextName;

        if (nextPassword) {
          data.password = nextPassword;
          data.passwordConfirm = nextPassword;
        }

        try {
          await pb.collection("users").update(userId, data);
          localStorage.setItem("octyUserName", nextName);
          const nextDisplayName = nextName
            ? nextName.toUpperCase()
            : "UTILISATEUR";
          if (profileUserName) {
            profileUserName.textContent = nextDisplayName;
          }
          if (progressUserName) {
            progressUserName.textContent = nextDisplayName;
          }
          password.value = "";
          setMessage("Informations mises a jour.", "#1f6d14");
        } catch {
          setMessage("Impossible de mettre a jour ces informations.");
        }
      });
    }

    const avatarKey = userId
      ? `octySelectedAvatar:${userId}`
      : "octySelectedAvatar:guest";

    const getAvatarRequiredLevel = (button) => {
      const value = Number.parseInt(button.dataset.requiredLevel || "1", 10);
      return Number.isFinite(value) && value > 0 ? value : 1;
    };

    const isAvatarUnlocked = (button) =>
      avatarUnlockLevel >= getAvatarRequiredLevel(button);

    avatarButtons.forEach((button) => {
      const locked = !isAvatarUnlocked(button);
      button.classList.toggle("is-level-locked", locked);
      button.classList.toggle("is-locked", locked);
      button.setAttribute("aria-disabled", locked ? "true" : "false");

      if (button instanceof HTMLButtonElement) {
        button.disabled = locked;
      }

      const lockBadge = button.querySelector("[data-avatar-lock-badge]");
      const unlockLabel = button.querySelector("[data-avatar-unlock-label]");

      if (lockBadge instanceof HTMLElement) {
        lockBadge.hidden = !locked;
      }

      if (unlockLabel instanceof HTMLElement) {
        unlockLabel.hidden = !locked;
      }
    });

    const storedAvatar =
      localStorage.getItem(avatarKey) || "/svg/octy-neutral.svg";
    const storedAvatarButton = avatarButtons.find(
      (button) => button.dataset.avatar === storedAvatar,
    );
    const selectedAvatar =
      storedAvatarButton && isAvatarUnlocked(storedAvatarButton)
        ? storedAvatar
        : "/svg/octy-neutral.svg";

    if (storedAvatar !== selectedAvatar) {
      localStorage.setItem(avatarKey, selectedAvatar);
    }

    const setAvatar = (src) => {
      if (currentAvatar instanceof HTMLImageElement) {
        currentAvatar.src = src;
      }

      if (progressAvatar instanceof HTMLImageElement) {
        progressAvatar.src = src;
      }

      avatarButtons.forEach((button) => {
        button.classList.toggle("is-selected", button.dataset.avatar === src);
      });
    };

    setAvatar(selectedAvatar);

    avatarButtons.forEach((button) => {
      button.addEventListener("click", () => {
        if (!isAvatarUnlocked(button)) return;
        const avatar = button.dataset.avatar;
        if (!avatar) return;
        localStorage.setItem(avatarKey, avatar);
        setAvatar(avatar);
      });
    });

    if (progressionLevel) {
      progressionLevel.textContent = String(userProgress.level);
    }

    applyProgressCards();

    if (userId && userId !== "guest") {
      getProgressionsByUser(userId)
        .then((progressions) => {
          if (progressions.length > 0) {
            applyProgressCards(progressions);
          }
        })
        .catch(() => {});
    }

    logoutButton?.addEventListener("click", () => {
      pb.authStore.clear();
      localStorage.removeItem("userId");
      sessionStorage.removeItem("userId");
      window.location.href = "/connexion";
    });
  }
</script>
