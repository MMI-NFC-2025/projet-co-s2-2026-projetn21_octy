---
// @ts-nocheck
import Layout from '../layouts/Layout.astro';
import CourseLoadingScreen from '../components/CourseLoadingScreen.astro';
import { getEtapesByParcours, getParcours, getQuizByEtape } from '../js/backend.mjs';

const tousLesParcours = await getParcours();
const displayByOrder = {
  1: { key: 'logement', shortName: 'Aides au logement' },
  2: { key: 'caf', shortName: 'La CAF' },
  3: { key: 'admin', shortName: 'Formulaire' },
  4: { key: 'budget', shortName: 'Budget' },
};

const vraisParcours = tousLesParcours
  .filter((parcours) => parcours.statut !== 'payant' && displayByOrder[Number(parcours.ordre)])
  .slice(0, 4);

const parcoursCards = await Promise.all(
  vraisParcours.map(async (parcours) => {
    const order = Number(parcours.ordre);
    const etapes = await getEtapesByParcours(parcours.id);
    const steps = await Promise.all(
      etapes.map(async (etape) => {
        const quiz = await getQuizByEtape(etape.id);

        return {
          id: etape.id,
          href: `/parcours/${parcours.id}/etape/${etape.id}`,
          quizId: quiz[0]?.id ?? '',
        };
      })
    );
    const firstEtape = etapes[0];

    return {
      id: parcours.id,
      order,
      key: displayByOrder[order].key,
      shortName: displayByOrder[order].shortName,
      fullName: parcours.nom_parcours,
      href: firstEtape ? `/parcours/${parcours.id}/etape/${firstEtape.id}` : '/parcours',
      steps,
    };
  })
);

const fallbackCurrent = parcoursCards.filter((parcours) => parcours.order === 1 || parcours.order === 3);
const fallbackRecommended = parcoursCards.filter((parcours) => parcours.order !== 1 && parcours.order !== 3);
const parcoursPayload = JSON.stringify(parcoursCards).replace(/</g, '\\u003c');
---

<Layout titre="Accueil - Octy">
  <main class="home-page" data-home-page>
    <section class="home-hero" aria-labelledby="home-title">
      <img src="/svg/vagues.svg" alt="" class="home-waves" aria-hidden="true" />

      <div class="home-mascot-frame" aria-hidden="true">
        <img src="/svg/octy-neutral.svg" alt="" class="home-mascot" data-home-avatar />
        <span class="home-level" data-user-level>0</span>
      </div>

      <p class="home-kicker">Bon retour parmis nous</p>
      <h1 id="home-title">
        <span data-user-name>Utilisateur</span>&nbsp;!
      </h1>
    </section>

    <section class="home-current" aria-labelledby="current-title" data-current-section>
      <img src="/svg/fond1.svg" alt="" class="home-shape" aria-hidden="true" />
      <div class="home-section-inner">
        <h2 id="current-title">Parcours en cours&nbsp;:</h2>
        <div class="home-card-stack" data-current-list>
          {
            fallbackCurrent.map((parcours) => (
              <article
                class="home-card is-current"
                data-parcours-card
                data-parcours-id={parcours.id}
                data-parcours-key={parcours.key}
                data-parcours-order={parcours.order}
              >
                <h3>{`Parcours ${parcours.order} - ${parcours.shortName}`}</h3>
                <p data-card-subtitle>Reprendre l&agrave; o&ugrave; vous en &eacute;tiez</p>
                <a href={parcours.href} class="home-card-action" data-course-action data-course-loading-link>
                  <span class="home-action-arrow" aria-hidden="true"></span>
                  <span data-action-label>CONTINUER&nbsp;!</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-recommended" aria-labelledby="recommended-title" data-recommended-section>
      <img src="/svg/vagues.svg" alt="" class="home-waves" aria-hidden="true" />

      <div class="home-section-inner">
        <h2 id="recommended-title">Parcours recommand&eacute;s&nbsp;:</h2>
        <div class="home-card-stack" data-recommended-list>
          {
            fallbackRecommended.map((parcours) => (
              <article
                class="home-card is-recommended"
                data-parcours-card
                data-parcours-id={parcours.id}
                data-parcours-key={parcours.key}
                data-parcours-order={parcours.order}
              >
                <h3>{`Parcours ${parcours.order} - ${parcours.shortName}`}</h3>
                <p data-card-subtitle>Commencer ce parcours</p>
                <a href={parcours.href} class="home-card-action" data-course-action data-course-loading-link>
                  <span class="home-action-arrow" aria-hidden="true"></span>
                  <span data-action-label>C&rsquo;EST PARTI&nbsp;!</span>
                </a>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <section class="home-more" aria-labelledby="more-title">
      <img src="/svg/fond2.svg" alt="" class="home-shape" aria-hidden="true" />
      <div class="home-section-inner">
        <h2 id="more-title">Vous en voulez plus&nbsp;?</h2>
        <article class="home-card is-current home-explore-card">
          <h3>
            <span>Explorer</span>
            <span>les diff&eacute;rents parcours</span>
          </h3>
          <a href="/parcours" class="home-card-action">
            <span class="home-action-arrow" aria-hidden="true"></span>
            <span>ALLONS-Y&nbsp;!</span>
          </a>
        </article>
      </div>
    </section>

    <script type="application/json" id="home-parcours-data" set:html={parcoursPayload}></script>
  </main>

  <CourseLoadingScreen />
</Layout>

