<script>
  // @ts-nocheck
  import { getUserProgress } from '../js/progression.mjs';
  import { getProgressionsByUser } from '../js/backend.mjs';

  const root = document.querySelector('[data-home-page]');
  const dataElement = document.getElementById('home-parcours-data');

  const parseJson = (value) => {
    try {
      return value ? JSON.parse(value) : null;
    } catch {
      return null;
    }
  };

  const getPocketBaseUser = () => {
    const auth = parseJson(localStorage.getItem('pocketbase_auth'));
    return auth && typeof auth === 'object' && auth.model ? auth.model : null;
  };

  const getCurrentUserId = () => {
    const storedId = localStorage.getItem('userId') || sessionStorage.getItem('userId');
    const pocketBaseUser = getPocketBaseUser();
    return storedId || pocketBaseUser?.id || 'guest';
  };

  const getUserName = () => {
    const pocketBaseUser = getPocketBaseUser();
    const storedName = localStorage.getItem('octyUserName');
    const userName = storedName || pocketBaseUser?.prenom_nom || pocketBaseUser?.name || pocketBaseUser?.username;

    if (typeof userName === 'string' && userName.trim()) {
      return userName.trim().split(/\s+/)[0];
    }

    if (typeof pocketBaseUser?.email === 'string') {
      return pocketBaseUser.email.split('@')[0];
    }

    return 'Utilisateur';
  };

  const getAnswersForUser = (userId) => {
    const userAnswers = parseJson(localStorage.getItem(`octyEntryQuestionnaireAnswers:${userId}`));
    const sharedAnswers = parseJson(localStorage.getItem('octyEntryQuestionnaireAnswers'));

    if (userAnswers) return userAnswers;

    if (sharedAnswers && userId !== 'guest') {
      localStorage.setItem(`octyEntryQuestionnaireAnswers:${userId}`, JSON.stringify(sharedAnswers));
    }

    return sharedAnswers || {};
  };

  const getRecommendationOrder = (parcours, answers) => {
    if (!answers || Object.keys(answers).length === 0) {
      const fallbackRank = {
        logement: 0,
        admin: 1,
        caf: 2,
        budget: 3,
      };

      return [...parcours].sort((a, b) => fallbackRank[a.key] - fallbackRank[b.key]);
    }

    const weights = {
      logement: 0,
      caf: 0,
      admin: 0,
      budget: 0,
    };

    const add = (key, amount = 1) => {
      if (key in weights) weights[key] += amount;
    };

    Object.values(answers).forEach((answer) => {
      switch (answer) {
        case 'chercher_logement':
        case 'aide_logement':
          add('logement', 4);
          break;
        case 'gerer_caf':
        case 'suivre_caf':
        case 'erreur_caf':
          add('caf', 4);
          break;
        case 'dossier_administratif':
        case 'remplir_dossier':
        case 'comprendre_demande':
          add('admin', 4);
          break;
        case 'budget':
        case 'gerer_budget':
        case 'ajuster_budget':
        case 'argent':
          add('budget', 4);
          break;
        case 'jamais':
        case 'avec_aide':
        case 'comprends_peu':
        case 'perdu':
          add('admin', 3);
          add('logement', 1);
          add('caf', 1);
          break;
        case 'une_fois':
        case 'comprends_partiellement':
          add('admin', 2);
          break;
        case 'aides':
        case 'droits':
        case 'verifier_aides':
          add('caf', 2);
          add('logement', 1);
          break;
        case 'commencer':
          add('admin', 2);
          add('logement', 1);
          break;
        default:
          break;
      }
    });

    return [...parcours].sort((a, b) => {
      const scoreDiff = (weights[b.key] || 0) - (weights[a.key] || 0);
      return scoreDiff || a.order - b.order;
    });
  };

  const applyCardVariant = (card, variant) => {
    card.classList.toggle('is-current', variant === 'current');
    card.classList.toggle('is-recommended', variant === 'recommended');

    const label = card.querySelector('[data-action-label]');
    if (label) {
      label.textContent = variant === 'current' ? 'CONTINUER !' : "C'EST PARTI !";
    }

    const subtitle = card.querySelector('[data-card-subtitle]');
    if (subtitle) {
      subtitle.textContent = variant === 'current' ? 'Reprendre là où vous en étiez' : 'Commencer ce parcours';
    }
  };

  const getCompletedQuizzesFromProgressions = (progressions = []) => {
    return progressions.flatMap((progression) =>
      Array.isArray(progression?.quiz_termines)
        ? progression.quiz_termines.filter(Boolean).map(String)
        : []
    );
  };

  const getRelationId = (value) => {
    if (!value) return '';
    if (typeof value === 'string') return value;
    if (typeof value === 'object' && 'id' in value) return value.id;
    return '';
  };

  const getSafePercent = (value) => {
    const percent = Number.parseInt(value, 10);
    if (!Number.isFinite(percent)) return 0;
    return Math.min(100, Math.max(0, percent));
  };

  const uniqueIds = (items = []) => {
    return [...new Set(items.filter(Boolean).map(String))];
  };

  const getCurrentParcoursIdsFromProgressions = (progressions = []) => {
    return uniqueIds(
      progressions
        .filter((progression) => {
          const completedQuizzes = Array.isArray(progression?.quiz_termines)
            ? progression.quiz_termines
            : [];
          const percent = getSafePercent(progression?.pourcentage);
          return completedQuizzes.length > 0 && percent < 100;
        })
        .map((progression) => getRelationId(progression?.parcours))
    );
  };

  const getNextParcoursHref = (parcours, completedQuizzes = []) => {
    const completed = new Set(completedQuizzes.filter(Boolean).map(String));
    const steps = Array.isArray(parcours?.steps) ? parcours.steps : [];
    const nextStep = steps.find((step) => !step.quizId || !completed.has(String(step.quizId)));

    if (nextStep?.href) return nextStep.href;
    if (parcours?.id) return `/parcours/${parcours.id}/progression`;
    return parcours?.href || '/parcours';
  };

  if (root instanceof HTMLElement && dataElement) {
    const resetScrollFlag = 'octyHomeResetScrollOnReturn';
    const resetHomeScroll = () => {
      if (sessionStorage.getItem(resetScrollFlag) !== 'true') return;

      sessionStorage.removeItem(resetScrollFlag);
      if ('scrollRestoration' in history) {
        history.scrollRestoration = 'manual';
      }

      window.scrollTo(0, 0);
      requestAnimationFrame(() => {
        window.scrollTo(0, 0);
        requestAnimationFrame(() => window.scrollTo(0, 0));
      });
    };

    resetHomeScroll();
    window.addEventListener('pageshow', resetHomeScroll);

    const userId = getCurrentUserId();
    const userNameTarget = root.querySelector('[data-user-name]');
    const userLevelTarget = root.querySelector('[data-user-level]');
    const homeAvatar = root.querySelector('[data-home-avatar]');
    const currentList = root.querySelector('[data-current-list]');
    const recommendedList = root.querySelector('[data-recommended-list]');
    const allParcours = parseJson(dataElement.textContent) || [];
    const userProgress = getUserProgress(userId);
    const cards = Array.from(root.querySelectorAll('[data-parcours-card]'));
    const parcoursById = new Map(allParcours.map((parcours) => [parcours.id, parcours]));

    if (userNameTarget) {
      userNameTarget.textContent = getUserName();
    }

    if (userLevelTarget) {
      userLevelTarget.textContent = String(userProgress.level);
    }

    if (homeAvatar instanceof HTMLImageElement) {
      homeAvatar.src = localStorage.getItem(`octySelectedAvatar:${userId}`) || '/svg/octy-neutral.svg';
    }

    const pendingQuestionnaire = localStorage.getItem('octyEntryQuestionnairePending') === 'true';
    const questionnaireDone = localStorage.getItem(`octyEntryQuestionnaireDone:${userId}`) === 'true'
      || localStorage.getItem('octyEntryQuestionnaireDone') === 'true';

    if (pendingQuestionnaire && !questionnaireDone && userId !== 'guest') {
      window.location.href = '/questionnaire';
    }

    const stateKey = `octyHomeParcoursState:${userId}`;
    let state = parseJson(localStorage.getItem(stateKey));

    if (!state && allParcours.length) {
      const ordered = getRecommendationOrder(allParcours, getAnswersForUser(userId));
      state = {
        current: [],
        recommended: ordered.map((parcours) => parcours.id),
      };
      localStorage.setItem(stateKey, JSON.stringify(state));
    }

    const currentSection = root.querySelector('[data-current-section]');
    const recommendedSection = root.querySelector('[data-recommended-section]');
    const byId = new Map(cards.map((card) => [card.dataset.parcoursId, card]));
    const applyCourseActionHrefs = (completedQuizzes = []) => {
      cards.forEach((card) => {
        if (!(card instanceof HTMLElement)) return;

        const parcours = parcoursById.get(card.dataset.parcoursId);
        const action = card.querySelector('[data-course-action]');

        if (parcours && action instanceof HTMLAnchorElement) {
          action.href = getNextParcoursHref(parcours, completedQuizzes);
        }
      });
    };

    const renderParcoursState = (nextState) => {
      if (!nextState || !currentList || !recommendedList) return;

      const currentIds = uniqueIds(Array.isArray(nextState.current) ? nextState.current : []);
      const recommendedIds = uniqueIds(Array.isArray(nextState.recommended) ? nextState.recommended : []);
      const missingIds = allParcours
        .map((parcours) => parcours.id)
        .filter((id) => !currentIds.includes(id) && !recommendedIds.includes(id));

      currentList.textContent = '';
      recommendedList.textContent = '';

      currentIds.forEach((id) => {
        const card = byId.get(id);
        if (!card) return;
        applyCardVariant(card, 'current');
        currentList.append(card);
      });

      [...recommendedIds, ...missingIds].forEach((id) => {
        const card = byId.get(id);
        if (!card) return;
        applyCardVariant(card, 'recommended');
        recommendedList.append(card);
      });

      if (currentSection instanceof HTMLElement) {
        currentSection.hidden = false;
        currentSection.classList.toggle('is-empty', currentIds.length === 0);
      }
      if (recommendedSection instanceof HTMLElement) {
        recommendedSection.classList.toggle('is-first-section', currentIds.length === 0);
      }
    };

    if (state && currentList && recommendedList) {
      renderParcoursState(state);
    }

    applyCourseActionHrefs(userProgress.completedQuizzes);

    if (userId && userId !== 'guest') {
      getProgressionsByUser(userId)
        .then((progressions) => {
          const completedQuizzes = [
            ...userProgress.completedQuizzes,
            ...getCompletedQuizzesFromProgressions(progressions),
          ];
          const currentFromProgressions = getCurrentParcoursIdsFromProgressions(progressions);
          if (currentFromProgressions.length) {
            const currentState = parseJson(localStorage.getItem(stateKey)) || state || { current: [], recommended: [] };
            const current = uniqueIds([
              ...currentFromProgressions,
              ...(Array.isArray(currentState.current) ? currentState.current : []),
            ]);
            const recommended = uniqueIds(
              Array.isArray(currentState.recommended) ? currentState.recommended : []
            ).filter((id) => !current.includes(id));
            const missingRecommended = allParcours
              .map((parcours) => parcours.id)
              .filter((id) => !current.includes(id) && !recommended.includes(id));
            const syncedState = {
              current,
              recommended: [...recommended, ...missingRecommended],
            };

            state = syncedState;
            localStorage.setItem(stateKey, JSON.stringify(syncedState));
            renderParcoursState(syncedState);
          }
          applyCourseActionHrefs(completedQuizzes);
        })
        .catch(() => {});
    }

    root.querySelectorAll('[data-course-action]').forEach((link) => {
      link.addEventListener('click', () => {
        sessionStorage.setItem(resetScrollFlag, 'true');

        const card = link.closest('[data-parcours-card]');
        const parcoursId = card instanceof HTMLElement ? card.dataset.parcoursId : null;

        if (!parcoursId) return;

        const currentState = parseJson(localStorage.getItem(stateKey)) || { current: [], recommended: [] };
        const current = Array.isArray(currentState.current) ? currentState.current : [];
        const recommended = Array.isArray(currentState.recommended) ? currentState.recommended : [];

        const wasEmpty = current.length === 0;
        currentState.current = [parcoursId, ...current.filter((id) => id !== parcoursId)];
        currentState.recommended = recommended.filter((id) => id !== parcoursId);
        localStorage.setItem(stateKey, JSON.stringify(currentState));

        if (wasEmpty && currentSection instanceof HTMLElement) {
          currentSection.hidden = false;
        }
        if (wasEmpty && recommendedSection instanceof HTMLElement) {
          recommendedSection.classList.remove('is-first-section');
        }
      });
    });
  }
</script>
