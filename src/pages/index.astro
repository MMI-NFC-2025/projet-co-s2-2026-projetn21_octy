---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/accueil/Hero.astro";
import ProblemSection from "../components/accueil/ProblemSection.astro";
import SolutionSection from "../components/accueil/SolutionSection.astro";
import Parcours from "../components/accueil/Parcours.astro";
import PourQui from "../components/accueil/PourQui.astro";
import FAQ from "../components/accueil/FAQ.astro";
import Tarifs from "../components/accueil/Tarifs.astro";
import Newsletter from "../components/accueil/Newsletter.astro";
import CTA from "../components/accueil/CTA.astro";
---

<Layout titre="Octy - Tes démarches administratives simplifiées">
  <Hero />
  <ProblemSection />
  <SolutionSection />
  <Parcours />
  <PourQui />
  <div class="relative z-10">
    <FAQ />
  </div>
  <div class="relative z-10">
    <Tarifs />
  </div>
  <div class="relative z-10">
    <Newsletter />
  </div>
  <CTA />
</Layout>
