---
import MembreCard from '../MembreCard.astro';
import tete1Url from '../../assets/svg/equipe/tete1.svg?url';
import tete2Url from '../../assets/svg/equipe/tete2.svg?url';
import tete3Url from '../../assets/svg/equipe/tete3.svg?url';

const membres = [
  {
    prenom: 'Elisa',
    nom: 'Saltini',
    image: tete1Url,
  },
  {
    prenom: 'Antonin',
    nom: 'Seichepine',
    image: tete2Url,
  },
  {
    prenom: 'Leonie',
    nom: 'Pruniaux',
    image: tete3Url,
  },
];
---

<section class="section-responsive safe-overflow relative left-1/2 w-screen max-w-none -translate-x-1/2 overflow-hidden bg-orange px-7 pt-16 pb-24 lg:px-10 lg:py-20">
  <div class="mx-auto flex w-full max-w-[22rem] flex-col gap-10 text-beige md:max-w-[42rem] lg:max-w-336 lg:mygrid lg:items-start lg:gap-y-10">
    <div class="flex flex-col gap-4 lg:col-start-1 lg:col-span-16 lg:max-w-208">
      <h2 class="text-center font-heading text-[2.25rem] font-bold uppercase leading-[1.05] lg:text-left">
        L'&eacute;quipe
      </h2>

      <p class="font-sans text-[1.05rem] font-bold leading-tight md:text-lg">
        Projet r&eacute;alis&eacute; par :
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8 lg:col-start-1 lg:col-span-20 lg:mx-auto lg:w-full lg:max-w-[34rem] lg:gap-12 lg:justify-items-center">
      {membres.map((membre) => <MembreCard membre={membre} />)}
    </div>

    <p class="max-w-[18rem] font-sans text-[1rem] leading-[1.2] text-beige/95 md:max-w-[24rem] lg:col-start-1 lg:col-span-16 lg:max-w-none lg:whitespace-nowrap">
      <span class="block lg:inline">BUT M&eacute;tiers du Multim&eacute;dia et de l'Internet</span>
      <span class="block lg:ml-2 lg:inline">Universit&eacute; de Franche-Comt&eacute;</span>
    </p>
  </div>
</section>
