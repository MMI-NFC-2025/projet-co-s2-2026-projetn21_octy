            </g>
            <defs>
              <radialGradient id="paint0_footer_desk" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="translate(108.503 109.5) scale(124.756 124.885)">
                <stop offset="0.3" stop-color="#E33D3D"/>
                <stop offset="0.94" stop-color="#BC201F"/>
              </radialGradient>
              <clipPath id="clip0_footer_desk">
                <rect width="149" height="141" fill="white" transform="translate(34 39)"/>
              </clipPath>
            </defs>
          </svg>
        </div>
      </div>

      <!-- Séparateur mobile -->
      <div class="h-0.5 bg-beige -mx-7 mb-8 lg:hidden"></div>

      <!-- Col droite : nav + copyright -->
      <div class="lg:col-start-12 lg:col-span-9 lg:flex lg:flex-col lg:justify-between">
        <nav class="flex flex-col gap-3 mb-8 lg:mb-0" aria-label="Navigation pied de page">
          <a href="/" class="text-beige text-lg font-heading font-semibold">Accueil</a>
          <a href="/a-propos" class="text-beige text-lg font-heading font-semibold">À propos</a>
          <a href="/partenaires" class="text-beige text-lg font-heading font-semibold">Partenaires</a>
          <a href="/contact" class="text-beige text-lg font-heading font-semibold">Contact</a>
        </nav>

        <p class="text-beige text-xs lg:mt-8">
          Octy © 2026 - Antonin Seichepine, Elisa Saltini, Léonie Pruniaux
        </p>
      </div>

    </div>
  </div>
</footer>
