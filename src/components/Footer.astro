---
// Footer Octy

import footerBackgroundUrl from '../assets/svg/footer-background.svg?url';
import desktopWaveUrl from '../assets/svg/desktop-wave.svg?url';

const { waveBg = 'bg-orange' } = Astro.props;
---

<footer>
  <!-- Vague du footer : SVG exact avec debordement lateral -->
  <div class:list={[waveBg, '-mt-px safe-overflow overflow-hidden lg:hidden']}>
    <div class="decor-wave-bleed relative h-[41px]">
      <img
        src={footerBackgroundUrl}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute left-0 top-0 block h-auto w-full max-w-none"
      />
    </div>
  </div>

  <div class:list={[waveBg, '-mt-px hidden overflow-hidden lg:block']}>
    <div class="relative h-[78px] w-[112%] -ml-[6%] xl:h-[98px]">
      <img
        src={desktopWaveUrl}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute inset-x-0 top-0 block h-auto w-full max-w-none [transform:scaleY(-1)]"
      />
    </div>
  </div>

  <!-- Contenu du footer -->
  <div class="bg-red px-7 pt-6 pb-10 lg:px-10">
    <div class="lg:mx-auto lg:max-w-336 lg:mygrid lg:items-start lg:gap-y-0">

      <!-- Col gauche : disclaimer + mascotte -->
      <div class="lg:col-start-1 lg:col-span-9 lg:flex lg:flex-col lg:gap-8">
        <p class="text-beige text-base font-medium leading-relaxed">
          Octy est un outil pédagogique d'information.<br />
          Les contenus proposés ne remplacent pas les informations officielles des administrations.
        </p>

        <div class="flex justify-center my-10 lg:my-0 lg:justify-start">
          <svg width="120" height="120" viewBox="0 0 218 218" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <circle cx="109" cy="109" r="104" fill="#E44D4C" stroke="#FFCFA5" stroke-width="10"/>
            <g clip-path="url(#clip0_footer_desk)">
