    <rect y="35" width="415" height="734" fill="#FFCFA5"></rect>
    <rect
      width="262"
      height="69"
      transform="matrix(-1 0 0 1 262 0)"
      fill="#FFCFA5"></rect>
    <circle cx="261.5" cy="34.5" r="34.5" fill="#FFCFA5"></circle>
    <rect x="148" y="734" width="267" height="69" fill="#FFCFA5"></rect>
    <circle
      cx="34.5"
      cy="34.5"
      r="34.5"
      transform="matrix(-1 0 0 1 183 734)"
      fill="#FFCFA5"></circle>
