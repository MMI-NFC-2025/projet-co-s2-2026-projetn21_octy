---
import cardOneImage from '../../assets/card-micro-cours.png';
---

<article class="mx-auto w-full max-w-[22rem] rounded-[20px] bg-beige px-6 pb-7 pt-7 text-center">
  <p class="text-left font-sans text-sm font-semibold text-orange">Apprentissage</p>

  <h3 class="mt-3 text-left font-heading text-[2rem] font-bold leading-[1.05] text-orange">
    Des micro-cours pour comprendre l'essentiel !
  </h3>

  <p class="mt-4 max-w-[15.5rem] text-left font-sans text-base leading-[1.4] text-orange">
    Des leçons courtes et claires pour comprendre chaque démarche :
  </p>

  <div class="mt-7 flex justify-center">
    <img
      src={cardOneImage.src}
      alt="Illustration des micro-cours Octy"
      loading="lazy"
      class="h-auto w-[18.75rem]"
    />
  </div>

  <div class="mt-8 flex justify-center">
    {/* TODO accessibilité: remplacer href="#" par la route cible quand elle sera validée. */}
    <a
      href="#"
      class="inline-flex w-full max-w-[19.875rem] items-center justify-center gap-3 rounded-[20px] bg-red px-7 py-4 font-sans text-[1.05rem] font-bold text-beige"
    >
      <svg width="33" height="14" viewBox="0 0 33 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M0 13.087V0.608696L21 4.26087L20.7 3.28344e-06L33 6.39131L20.7 14L21 9.73913L0 13.087Z" fill="#FFCFA5"/>
      </svg>
      Découvrir
    </a>
  </div>
</article>
