---
---

<section class="px-7 pt-12 pb-16 lg:py-20">
  <div class="mx-auto flex w-full max-w-92 flex-col lg:max-w-336 lg:px-8 lg:mygrid lg:items-start">

    <!-- Col gauche desktop : sur-titre + titre -->
    <div class="lg:col-start-1 lg:col-span-7 lg:pr-8">
      <p class="font-heading font-semibold text-sm text-beige text-center uppercase tracking-wide mb-4 lg:text-left">
        Pour qui ?
      </p>
      <h2 class="font-heading font-bold text-[2.25rem] leading-[1.05] text-beige text-center uppercase mb-10 lg:text-left lg:mb-0">
        Pour les jeunes qui entrent dans la vie adulte
      </h2>
    </div>

    <!-- Col droite desktop : 4 items en 2×2 -->
    <div class="lg:col-start-9 lg:col-span-12 lg:grid lg:grid-cols-2 lg:gap-x-8 lg:gap-y-6">

      <!-- Item 1 -->
      <div class="mb-6 lg:mb-0">
        <p class="font-sans font-bold text-base text-beige mb-1">Étudiants</p>
        <p class="font-sans font-medium text-base text-beige">
          qui découvrent leurs premières démarches administratives.
        </p>
      </div>

      <!-- Item 2 -->
      <div class="mb-6 lg:mb-0">
        <p class="font-sans font-bold text-base text-beige mb-1">Jeunes actifs</p>
        <p class="font-sans font-medium text-base text-beige">
          qui doivent gérer leurs droits et leurs obligations.
        </p>
      </div>

      <!-- Item 3 -->
      <div class="mb-6 lg:mb-0">
        <p class="font-sans font-bold text-base text-beige mb-1">Jeunes en recherche d'emploi</p>
        <p class="font-sans font-medium text-base text-beige">
          qui veulent comprendre leurs aides.
        </p>
      </div>

      <!-- Item 4 -->
      <div>
        <p class="font-sans font-bold text-base text-beige mb-1">Jeunes quittant le domicile familial</p>
        <p class="font-sans font-medium text-base text-beige">
          et qui doivent gérer l'administration pour la première fois.
        </p>
      </div>

    </div>
  </div>
</section>
