---
import SolutionCardOne from './SolutionCardOne.astro';
import SolutionCardTwo from './SolutionCardTwo.astro';
import SolutionCardThree from './SolutionCardThree.astro';
import cardOneImage from '../../assets/card-micro-cours.png';
import cardTwoImage from '../../assets/card-quiz-interactif.png';
import cardThreeImage from '../../assets/card-organismes-utiles.png';
---

{/* ── Mobile : layout vertical inchangé ─────────────────────────────────── */}
<section class="px-5 pb-14 pt-14 lg:hidden">
  <div class="mx-auto flex w-full max-w-[23rem] flex-col items-center">
    <p class="font-heading text-[1.4rem] font-bold uppercase tracking-[0.02em] text-beige">
      LA SOLUTION :
    </p>

    <h2 class="mt-4 max-w-[19rem] text-center font-heading text-[2.25rem] font-bold leading-[1.05] uppercase text-beige">
      Une méthode simple pour comprendre l'administration
    </h2>

    <div class="mt-7 w-full max-w-[18.25rem] self-center">
      <p class="font-sans text-base leading-[1.55] text-beige">
        Octy transforme les démarches administratives en <span class="font-bold">parcours pédagogiques simples</span>.
      </p>
      <p class="mt-4 font-sans text-base leading-[1.55] text-beige">
        Au lieu de faire les démarches à votre place, Octy vous explique <span class="font-bold">comment fonctionne le système</span> pour que vous puissiez <span class="font-bold">agir en autonomie</span>.
      </p>
    </div>

    <div class="mt-10 w-full">
      <SolutionCardOne />
    </div>

    <div class="relative z-10 mt-8 w-full">
      <SolutionCardTwo />
    </div>

    <div class="relative z-10 -mt-10 w-full">
      <SolutionCardThree />
    </div>
  </div>
</section>

{/* ── Desktop : grille 20 colonnes ───────────────────────────────────────── */}
<section class="hidden lg:block bg-orange py-20">
  <div class="mx-auto max-w-336 px-8 mygrid items-start">

    {/* Colonne intro : cols 1–7 */}
    <div class="col-start-1 col-span-7 flex flex-col gap-6 pt-4">
      <p class="font-heading text-[1.2rem] font-bold uppercase tracking-[0.02em] text-beige">
        LA SOLUTION :
      </p>
      <h2 class="font-heading text-[2.25rem] font-bold leading-[1.05] uppercase text-beige">
        Une méthode simple pour comprendre l'administration
      </h2>
      <p class="font-sans text-base leading-[1.55] text-beige">
        Octy transforme les démarches administratives en <span class="font-bold">parcours pédagogiques simples</span>.
      </p>
      <p class="font-sans text-base leading-[1.55] text-beige">
        Au lieu de faire les démarches à votre place, Octy vous explique <span class="font-bold">comment fonctionne le système</span> pour que vous puissiez <span class="font-bold">agir en autonomie</span>.
      </p>
    </div>

    {/* 3 cards côte à côte : cols 8–20 */}
    <div class="col-start-8 col-span-13 grid grid-cols-3 gap-5 items-stretch">

      {/* Card 1 : Apprentissage */}
      <article class="w-full rounded-[20px] bg-beige px-6 pb-7 pt-7 text-center flex flex-col">
        <p class="text-left font-sans text-sm font-semibold text-orange">Apprentissage</p>
        <h3 class="mt-3 min-h-20 text-left font-heading text-[1.5rem] font-bold leading-[1.05] text-orange">
          Des micro-cours pour comprendre l'essentiel !
        </h3>
        <p class="mt-4 min-h-16 text-left font-sans text-sm leading-[1.4] text-orange">
          Des leçons courtes et claires pour comprendre chaque démarche :
        </p>
        <div class="mt-6 mx-auto aspect-square w-full max-w-48 overflow-hidden rounded-[1rem]">
          <img
            src={cardOneImage.src}
            alt="Illustration des micro-cours Octy"
            loading="lazy"
            class="h-full w-full object-cover object-center"
          />
        </div>
        <div class="mt-auto pt-8 flex justify-center">
          {/* TODO accessibilité: remplacer href="#" par la route cible quand elle sera validée. */}
          <a href="#" class="inline-flex w-full items-center justify-center gap-3 rounded-[20px] bg-red px-5 py-3 font-sans text-[0.95rem] font-bold text-beige">
            <svg width="28" height="12" viewBox="0 0 33 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 13.087V0.608696L21 4.26087L20.7 3.28344e-06L33 6.39131L20.7 14L21 9.73913L0 13.087Z" fill="#FFCFA5"/>
            </svg>
            Découvrir
          </a>
        </div>
      </article>

      {/* Card 2 : Vérifier */}
      <article class="w-full rounded-[20px] bg-red px-6 pb-7 pt-7 flex flex-col">
        <p class="text-left font-sans text-[0.7rem] leading-none text-beige">Vérifier</p>
        <h3 class="mt-4 min-h-20 text-left font-heading text-[1.5rem] font-bold leading-[1.05] text-beige">
          Quiz interactifs pour tester vos connaissances
        </h3>
        <p class="mt-4 min-h-16 text-left font-sans text-sm leading-[1.15] text-beige">
          Vérifiez rapidement que vous avez compris :
        </p>
        <div class="mt-6 mx-auto aspect-square w-full max-w-48 overflow-hidden rounded-[1rem]">
          <img
            src={cardTwoImage.src}
            alt="Illustration du quiz interactif Octy"
            loading="lazy"
            class="h-full w-full object-cover object-[50%_52%]"
          />
        </div>
        <div class="mt-auto pt-8 flex justify-center">
          {/* TODO accessibilité: remplacer href="#" par la route cible quand elle sera validée. */}
          <a href="#" class="inline-flex w-full items-center justify-center gap-3 rounded-[20px] bg-beige px-5 py-3 font-sans text-[0.95rem] font-bold text-red">
            <svg width="28" height="12" viewBox="0 0 33 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 13.087V0.608696L21 4.26087L20.7 3.28344e-06L33 6.39131L20.7 14L21 9.73913L0 13.087Z" fill="currentColor"/>
            </svg>
            Tester
          </a>
        </div>
      </article>

      {/* Card 3 : S'orienter */}
      <article class="w-full rounded-[20px] bg-beige px-6 pb-7 pt-7 flex flex-col">
        <p class="text-left font-sans text-[0.7rem] leading-none text-orange">S'orienter</p>
        <h3 class="mt-4 min-h-20 text-left font-heading text-[1.5rem] font-bold leading-[1.05] text-orange">
          Trouver le bon organisme
        </h3>
        <p class="mt-4 min-h-16 text-left font-sans text-sm leading-[1.2] text-orange">
          Localisez rapidement les services utiles près de vous : CAF, missions locales, France Services...
        </p>
        <div class="mt-6 mx-auto aspect-square w-full max-w-48 overflow-hidden rounded-[1rem]">
          <img
            src={cardThreeImage.src}
            alt="Illustration pour trouver les bons services"
            loading="lazy"
            class="h-full w-full scale-[1.08] object-cover object-[50%_78%]"
          />
        </div>
        <div class="mt-auto pt-8 flex justify-center">
          {/* TODO accessibilité: remplacer href="#" par la route cible quand elle sera validée. */}
          <a href="#" class="inline-flex w-full items-center justify-center gap-3 rounded-[20px] bg-red px-5 py-3 font-sans text-[0.95rem] font-bold text-beige">
            <svg width="28" height="12" viewBox="0 0 33 14" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <path d="M0 13.087V0.608696L21 4.26087L20.7 3.28344e-06L33 6.39131L20.7 14L21 9.73913L0 13.087Z" fill="currentColor"/>
            </svg>
            Consulter
          </a>
        </div>
      </article>

    </div>
  </div>
</section>
