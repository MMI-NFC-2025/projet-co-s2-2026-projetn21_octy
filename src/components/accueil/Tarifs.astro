  <div class="decor-bg lg:hidden" aria-hidden="true">
    <svg class="decor-svg" preserveAspectRatio="xMidYMid slice" width="393" height="1321" viewBox="0 0 393 1321" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <rect class="fill-red" width="262" height="69" transform="matrix(-1 -4.37114e-08 -4.37114e-08 1 393 1252)"/>
      <circle class="fill-red" cx="34.5" cy="34.5" r="34.5" transform="matrix(-1 -4.37114e-08 -4.37114e-08 1 166 1252)"/>
