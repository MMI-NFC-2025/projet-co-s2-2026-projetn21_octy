      id="menu-toggle"
      type="button"
      aria-label="Ouvrir le menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      class="translate-y-2 lg:hidden"
    >
      <svg width="33" height="24" viewBox="0 0 33 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M13 12.352H33" stroke="#FFCFA5" stroke-width="2"/>
        <path d="M0 22.672H33" stroke="#FFCFA5" stroke-width="2"/>
        <path d="M0 1H33" stroke="#FFCFA5" stroke-width="2"/>
      </svg>
    </button>
  </div>

  <!-- Ligne beige séparatrice (mobile uniquement) -->
  {showDivider && <div class="h-[2px] bg-beige"></div>}

  <div class:list={[waveBg, 'hidden overflow-hidden lg:block']} aria-hidden="true">
    <div class="relative h-[78px] w-[112%] -ml-[6%] xl:h-[98px]">
      <img
        src={desktopWaveUrl}
        alt=""
        aria-hidden="true"
        loading="lazy"
        class="absolute inset-x-0 bottom-0 block h-auto w-full max-w-none"
      />
    </div>
  </div>
</header>

