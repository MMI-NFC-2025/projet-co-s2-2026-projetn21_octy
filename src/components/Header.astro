          </clipPath>
        </defs>
      </svg>
    </a>

    <button id="menu-close" type="button" aria-label="Fermer le menu" class="octy-menu-close">
      <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M5 5L23 23" stroke="#FFCFA5" stroke-width="2.5" stroke-linecap="round"/>
        <path d="M23 5L5 23" stroke="#FFCFA5" stroke-width="2.5" stroke-linecap="round"/>
      </svg>
    </button>
  </div>

  <div class="octy-header-divider"></div>

  <nav class="octy-mobile-nav" aria-label="Navigation principale">
    <a href={accueilHref} aria-current={isCurrentHref(accueilHref) ? 'page' : undefined} data-menu-link>Accueil</a>
    <a href="/parcours" aria-current={isCurrentHref('/parcours') ? 'page' : undefined} data-menu-link>Explorer</a>
    <a href="/carte" aria-current={isCurrentHref('/carte') ? 'page' : undefined} data-menu-link>Carte</a>
    <a href="/profil" aria-current={isCurrentHref('/profil') ? 'page' : undefined} data-menu-link>Profil</a>
    <a href="/premium" aria-current={isCurrentHref('/premium') ? 'page' : undefined} data-menu-link>Premium</a>
    <a href="/a-propos" aria-current={isCurrentHref('/a-propos') ? 'page' : undefined} data-menu-link>&Agrave; propos</a>
  </nav>

  <div class="octy-menu-wave-wrapper">
