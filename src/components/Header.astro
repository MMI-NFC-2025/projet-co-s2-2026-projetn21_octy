        <defs>
          <clipPath id="octy_logo_clip">
            <rect width="126" height="33" fill="white"/>
          </clipPath>
        </defs>
      </svg>
    </a>

    {showMenu ? (
      <div class="octy-header-actions">
        <a href="/premium" class="octy-crown-link" aria-label="Passer a Octy Premium">
          <img src="/svg/crown.svg" alt="" aria-hidden="true" class="octy-crown" />
        </a>
        <button
          id="menu-toggle"
          type="button"
          aria-label="Ouvrir le menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
          class="octy-menu-toggle"
        >
          <svg width="33" height="24" viewBox="0 0 33 24" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <path d="M13 12.352H33" stroke="#FFCFA5" stroke-width="2"/>
            <path d="M0 22.672H33" stroke="#FFCFA5" stroke-width="2"/>
            <path d="M0 1H33" stroke="#FFCFA5" stroke-width="2"/>
          </svg>
        </button>
      </div>
    ) : (
      <a href="/premium" class="octy-crown-link" aria-label="Passer a Octy Premium">
        <img src="/svg/crown.svg" alt="" aria-hidden="true" class="octy-crown" />
      </a>
    )}
  </div>

  {showDivider && <div class="octy-header-divider"></div>}
</header>

{showMenu && (
<div id="mobile-menu" class="octy-mobile-menu" aria-hidden="true">
  <div class="octy-header-inner">
    <a href={homeHref} class="octy-logo" aria-label="Accueil Octy" data-menu-link>
