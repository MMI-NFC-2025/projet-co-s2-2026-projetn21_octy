    <nav class="hidden lg:flex lg:items-center lg:gap-10" aria-label="Navigation principale">
      <a href="/" class="font-heading text-[1.05rem] font-semibold text-beige hover:text-beige/80 transition-colors">Accueil</a>
      <a href="/a-propos" class="font-heading text-[1.05rem] font-semibold text-beige hover:text-beige/80 transition-colors">À propos</a>
      <a href="/partenaires" class="font-heading text-[1.05rem] font-semibold text-beige hover:text-beige/80 transition-colors">Partenaires</a>
      <a href="/contact" class="inline-flex items-center gap-2 rounded-[10px] bg-beige px-5 py-2 font-heading text-[1.05rem] font-semibold text-red hover:bg-beige/90 transition-colors">Contact</a>
    </nav>

    <!-- Menu burger (masqué sur desktop) -->
