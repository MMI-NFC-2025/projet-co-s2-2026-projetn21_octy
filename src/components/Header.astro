---
const {
  showDivider = true,
  showMenu = true,
  homeHref = '/accueil',
  accueilHref = '/accueil',
} = Astro.props;

const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrentHref = (href) => {
  const normalizedHref = href.replace(/\/$/, '') || '/';
  if (normalizedHref === '/parcours') {
    return currentPath === '/parcours' || currentPath.startsWith('/parcours/');
  }
  return currentPath === normalizedHref;
};
---

<header class="octy-header">
  <div class="octy-header-inner">
    <a href={homeHref} class="octy-logo" aria-label="Accueil Octy">
      <svg width="126" height="33" viewBox="0 0 126 33" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <g clip-path="url(#octy_logo_clip)">
